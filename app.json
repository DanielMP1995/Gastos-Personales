{
  "expo": {
    "name": "GASTOS PERSONALES",
    "slug": "app-gastos-personales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/icono-app.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/img/logov3.1.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B5D4B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.appgastospersonales"
    },
    "web": {
      "favicon": "./assets/img/logov3.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5D4B",
          "image": "./assets/img/logov3.1.png",
          "imageWidth": 300
        }
      ]
    ]
  }
}